    "\\(\\s*\\d{2,3}\\s*kbps\\s*\\)",
    "\\[\\s*\\d{2,3}\\s*kbps\\s*\\]",
    "\\b\\d{2,3}\\s*kbps\\b",
    "\\(\\s*www\\.[^)]*\\)",
    "\\[\\s*www\\.[^\\]]*\\]",
    "\\[\\s*www\\s[^\\]]*\\]",
    "\\(\\s*www\\s[^)]*\\)",
    "\\bwww\\.[\\w.-]+\\.[a-z]{2,}\\b",
    "\\bhttps?://\\S+",
    "^#\\s*\\d{1,3}\\s+"
